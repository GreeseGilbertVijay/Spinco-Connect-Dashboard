# Copy to .env before running.
DATABASE_URL="mongodb://USER:PASSWORD@HOST:27017/DATABASE?ssl=true&replicaSet=REPLICA_SET&authSource=admin&retryWrites=true&w=majority"
SESSION_SECRET="replace-with-a-random-secret-at-least-32-characters"
# Base64-encoded 32-byte key. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DEVICE_TOKEN_ENCRYPTION_KEY="replace-with-base64-encoded-32-byte-key"
# Set to the LAN reachable origin used by the TV. HTTPS is required in production.
APP_BASE_URL="http://192.168.1.25:3000"
NODE_ENV="development"
# Used only by npm run admin:create; never put the password in source control.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-long-unique-password"
# Local development data paths are relative to the backend project.
UPLOADS_DIR="./data/uploads"
# New uploads go to this Google Drive folder once all four values are set; until then they stay in UPLOADS_DIR.
# Client ID and secret come from a Google Cloud "Desktop app" OAuth client. npm run drive:auth fills in the token.
GOOGLE_DRIVE_FOLDER_ID="1fVMTKUDyUSOBxeUMcW1cii0CHBheNooZ"
GOOGLE_DRIVE_CLIENT_ID=""
GOOGLE_DRIVE_CLIENT_SECRET=""
GOOGLE_DRIVE_REFRESH_TOKEN=""
